# Copy to .env and fill in. Every service has a free tier with no credit card.
# Anything left empty falls back to a local equivalent (SQLite, in-memory index, memory cache).

# ---- LLMs (provider chains are ordered: primary first, failover next) -------------------------
GEMINI_API_KEY=
GROQ_API_KEY=
ANTHROPIC_API_KEY=                       # optional paid upgrade, e.g. anthropic:claude-haiku-4-5
LLM_CHAIN_TRIAGE=gemini:gemini-3.5-flash-lite,gemini:gemini-3.1-flash-lite,groq:openai/gpt-oss-20b,groq:openai/gpt-oss-120b
LLM_CHAIN_DRAFT=groq:openai/gpt-oss-120b,groq:openai/gpt-oss-20b,gemini:gemini-3.1-flash-lite,gemini:gemini-3.5-flash-lite
LLM_CHAIN_ASSIST=groq:openai/gpt-oss-120b,groq:openai/gpt-oss-20b,gemini:gemini-3.1-flash-lite
LLM_CHAIN_JUDGE=groq:qwen/qwen3.8-27b,gemini:gemini-3.5-flash-lite
QUOTA_RPD_GEMINI=1000                    # daily request budget per model; failover at 90%
QUOTA_RPD_GROQ=1000
LLM_RPM_GEMINI=14                        # client-side per-model rate limits (free tiers: 15 RPM / 8k TPM)
LLM_RPM_GROQ=28
LLM_TPM_GROQ=7500
LLM_MAX_QUEUE_S=6                        # wait at most this long for a slot, else fail over to the next model

# ---- Embeddings + rerank (Jina). Without a key the app uses a deterministic offline hash embedder.
JINA_API_KEY=
EMBED_MODEL=jina-embeddings-v3
EMBED_DIM=1024
RERANK_MODEL=jina-reranker-v2-base-multilingual

# ---- Storage ----------------------------------------------------------------------------------
DATABASE_URL=sqlite:///.runtime/app.sqlite3   # or Neon: postgresql://user:pass@host/db?sslmode=require
QDRANT_URL=                                   # empty -> in-memory local index rebuilt from the DB at startup
QDRANT_API_KEY=
COLLECTION_SUFFIX=v1

# ---- Upstash: shared cache / quota meters / rate limits ----------------------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---- Observability ----------------------------------------------------------------------------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ---- Decision thresholds (tune with `telecom-assistant eval`) ------------------------------------
MIN_RETRIEVAL_SCORE=0.30
STRONG_MATCH_SCORE=0.62
SELF_SERVICE_MIN_CONFIDENCE=0.62
SELF_SERVICE_MIN_RECURRENCE=3
CLARIFY_TARGET_POSTERIOR=0.80
CLARIFY_MAX_QUESTIONS=3
OOD_SIMILARITY=0.45

# ---- Runtime ----------------------------------------------------------------------------------
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DEMO_PASSWORD=                                # used by `telecom-assistant seed --demo`
